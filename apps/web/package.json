{
  "name": "school-oj-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run api:check && vue-tsc --noEmit && vite build && node scripts/check-initial-bundle.mjs && npm run build:ranking-export",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest",
    "api:generate": "node scripts/generate-openapi-client.mjs",
    "api:check": "node scripts/check-openapi-routes.mjs && node scripts/generate-openapi-client.mjs --check && node scripts/check-architecture.mjs",
    "qa:tickets": "node tests/e2e/ticket-feedback-qa.mjs",
    "qa:design": "node tests/e2e/plan-qa.mjs",
    "format": "prettier --write src",
    "qa:ticket-import": "node tests/e2e/ticket-import-team-qa.mjs",
    "qa:ticket-workflow": "node tests/e2e/ticket-workflow-qa.mjs",
    "build:ranking-export": "node scripts/build-ranking-export.mjs"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "axios": "^1.20.0",
    "element-plus": "^2.9.1",
    "katex": "^0.18.11",
    "markdown-it": "^14.3.2",
    "monaco-editor": "^0.52.2",
    "pinia": "^2.3.0",
    "vite": "^6.0.7",
    "vue": "^3.5.43",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.10.2",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^25.0.1",
    "playwright": "^1.62.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "unplugin-element-plus": "^0.11.2",
    "unplugin-vue-components": "^32.1.0",
    "vitest": "^4.1.10",
    "vue-tsc": "^2.2.0"
  }
}
