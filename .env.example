# Docker Compose host settings (not consumed by Go directly).
OJ_WORK_ROOT=/var/lib/school-oj-worker
WEB_PORT=25565
POSTGRES_BIND=127.0.0.1
POSTGRES_DB=oj
POSTGRES_USER=oj
# Set independent random passwords (openssl rand -hex 32); defaults are rejected.
POSTGRES_PASSWORD=
REDIS_PASSWORD=
MINIO_ROOT_USER=oj-storage
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=oj-artifacts
JWT_SECRET=
SEED_DATA=false
AUTO_MIGRATE=false
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
TRUSTED_PROXIES=127.0.0.1/32,::1/128,172.16.0.0/12
SMTP_HOST=
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=no-reply@huanghailuoj.local
MAIL_FROM_NAME=黄海在线
REQUEST_TIMEOUT_SECONDS=30
JPLAG_JAR_PATH=
JPLAG_WORK_DIR=/tmp/jplag
REDIS_DB=0
SANDBOX_CPU=1.0
SANDBOX_MEMORY_MB=256
SANDBOX_PIDS=128
SUBMISSION_TIMEOUT_SECONDS=300
SUBMISSION_MAX_RETRIES=3
SUBMISSION_RETRY_IDLE_SECONDS=60
SUBMISSION_GROUP=judge-workers
# Optional direct-process settings. Compose supplies its internal service names
# and OJ_WORK_ROOT mapping. Export these explicitly when using go run.
# APP_ADDR=:8080
# DATABASE_URL=host=localhost user=oj password=<random> dbname=oj port=15432 sslmode=disable TimeZone=Asia/Shanghai
# REDIS_ADDR=localhost:6379
# MINIO_ENDPOINT=localhost:9000
# MINIO_ACCESS_KEY=oj-storage
# MINIO_SECRET_KEY=<same-as-MINIO_ROOT_PASSWORD>
# MINIO_USE_SSL=false
# SANDBOX_WORK_ROOT=/var/lib/school-oj-worker
# DOCKER_SANDBOX_SECCOMP=/var/lib/school-oj-worker/seccomp/oj-seccomp.json
# WORKER_MONITOR_ADDR=:9091
# SUBMISSION_CONSUMER=<defaults-to-hostname; unique-per-worker>
# SUBMISSION_STREAM=oj.submissions (must match the API's fixed queue name)
# BACKUP_ROOT=/opt/School-OJ-backups
# RESTORE_PROJECT=school-oj-restore-drill
